{
  "identifier": "run.vineyard.pluginpacks.cdn_detect",
  "content_type": "vineyard:pluginpack",
  "name": "CDN / WAF Detection (cdncheck)",
  "version": "1.0.2",
  "description": "Detects CDN and WAF providers for IP addresses and domains using ProjectDiscovery's cdncheck dataset (MIT license).",
  "author": {
    "name": "VINEYARD",
    "url": "https://github.com/Vineyard-Intelligence"
  },
  "license": "Apache-2.0",
  "icon": "shield-check",
  "platforms": {
    "primary": "web",
    "web": {
      "runtime": "sandbox-js",
      "entry": "dist/pack.mjs"
    }
  },
  "distribution": {
    "kind": "git",
    "repository": "https://github.com/Vineyard-Intelligence/pluginpack-cdn-detect",
    "ref": "v1.0.0",
    "path": "plugins/cdn-detect.manifest.json"
  },
  "plugins": [
    {
      "identifier": "run.vineyard.plugins.cdn_detect_ip",
      "content_type": "vineyard:plugin",
      "name": "Detect CDN/WAF (IP)",
      "version": "1.0.1",
      "description": "Matches each selected IP Address against known CDN and WAF IP ranges (cdncheck) and sets the IP's organization to the matched provider, e.g. \"cloudflare (WAF)\". Unmatched IPs are left unchanged; creates no nodes.",
      "icon": "shield-check",
      "platforms": {
        "primary": "web",
        "web": {
          "runtime": "sandbox-js",
          "entry": "dist/pack.mjs"
        }
      },
      "io": {
        "consumes": [
          {
            "typepack": "run.vineyard.typepacks.infrastructure",
            "category": "infrastructure",
            "name": "ip_address"
          }
        ],
        "produces": []
      },
      "scopes": {
        "graph": [
          "node:read",
          "node:update"
        ]
      },
      "lifecycle": {
        "persistence": "opt-in",
        "controls": [
          "progress",
          "cancel"
        ],
        "progress": "determinate"
      }
    },
    {
      "identifier": "run.vineyard.plugins.cdn_detect_hostname",
      "content_type": "vineyard:plugin",
      "name": "Detect CDN (Hostname)",
      "version": "1.0.2",
      "description": "Follows each selected Domain's CNAME chain and matches it against known CDN hostname patterns (cdncheck). On a match, creates a CNAME DNS Record node (the matching hostname) linked \"has record\".",
      "icon": "route",
      "platforms": {
        "primary": "web",
        "web": {
          "runtime": "sandbox-js",
          "entry": "dist/pack.mjs"
        }
      },
      "io": {
        "consumes": [
          {
            "typepack": "run.vineyard.typepacks.infrastructure",
            "category": "infrastructure",
            "name": "domain"
          }
        ],
        "produces": [
          {
            "typepack": "run.vineyard.typepacks.infrastructure",
            "category": "infrastructure",
            "name": "dns_record"
          }
        ]
      },
      "scopes": {
        "graph": [
          "node:read",
          "node:create",
          "edge:create"
        ],
        "network": [
          {
            "endpoint": "https://cloudflare-dns.com/dns-query",
            "methods": [
              "GET"
            ],
            "purpose": "Resolve the CNAME chain of each selected domain."
          },
          {
            "endpoint": "https://dns.google/resolve",
            "methods": [
              "GET"
            ],
            "purpose": "Same lookup, used when cloudflare-dns.com fails."
          }
        ]
      },
      "lifecycle": {
        "persistence": "opt-in",
        "controls": [
          "progress",
          "cancel"
        ],
        "progress": "determinate"
      }
    }
  ]
}
